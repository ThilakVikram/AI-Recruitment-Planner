// Recruiter AI Co-Pilot — Prisma schema (MySQL)
//
// The User / Session / Account / Verification models follow the Better Auth
// core schema for better-auth 1.7 (verify with `npx @better-auth/cli generate`).
// `mustChangePassword` is an application field registered with Better Auth as
// an `additionalField` in lib/auth/auth.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─────────────────────────────────────────────────────────────
// Better Auth models
// ─────────────────────────────────────────────────────────────

model User {
  id                 String        @id
  name               String        @db.Text
  email              String
  emailVerified      Boolean       @default(false)
  image              String?       @db.Text
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @default(now()) @updatedAt
  mustChangePassword Boolean       @default(true)
  sessions           Session[]
  accounts           Account[]
  applicants         Applicant[]
  roles              Role[]
  recruitments       Recruitment[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// Application models
// Every role-specific record hangs off Role (directly or via Candidate),
// and deleting a role cascades to its whole workspace.
// ─────────────────────────────────────────────────────────────

model Role {
  id               String            @id @default(cuid())
  name             String            @db.VarChar(200)
  description      String?           @db.Text
  // Requisition details — managed on /roles and fed into the AI prompts.
  department       String?           @db.VarChar(100)
  location         String?           @db.VarChar(200)
  /// Onsite | Hybrid | Remote
  workMode         String?           @db.VarChar(20)
  /// Full-time | Part-time | Contract | Internship
  employmentType   String?           @db.VarChar(30)
  openings         Int               @default(1)
  experienceMin    Int?
  experienceMax    Int?
  salaryRange      String?           @db.VarChar(100)
  hiringManager    String?           @db.VarChar(200)
  targetDate       DateTime?         @db.Date
  /// Low | Medium | High | Urgent
  priority         String            @default("Medium") @db.VarChar(20)
  /// Open | On hold | Filled | Closed
  status           String            @default("Open") @db.VarChar(20)
  /// string[]
  requiredSkills   Json?
  /// string[]
  niceToHaveSkills Json?
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)
  stages           RoleStage[]
  candidates       Candidate[]
  sourcingProfiles SourcingProfile[]
  applicants       Applicant[]
  recruitments     Recruitment[]

  @@index([updatedAt])
  @@index([status])
  @@map("role")
}

/// One row per workflow stage (1–7) per role.
model RoleStage {
  id          String   @id @default(cuid())
  roleId      String
  stageNumber Int
  /// Free-text recruiter input for the stage.
  input       String?  @db.LongText
  /// Structured input (e.g. selected candidate ids for stages 5–7).
  inputData   Json?
  /// Rendered (markdown) AI output.
  output      String?  @db.LongText
  /// Structured AI output (e.g. Stage 1 JD/scorecard sections).
  outputData  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, stageNumber])
  @@index([roleId])
  @@map("role_stage")
}

model Candidate {
  id             String            @id @default(cuid())
  roleId         String
  name           String            @db.VarChar(200)
  /// Lower-cased, whitespace-collapsed name used for duplicate detection.
  normalizedName String            @db.VarChar(200)
  source         String?           @db.VarChar(100)
  score          Int?
  category       String?           @db.VarChar(20)
  summary        String?           @db.Text
  strengths      Json?
  gaps           Json?
  scoredAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  role           Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  cvs            CandidateCV[]
  tracker        CandidateTracker?

  @@index([roleId])
  @@index([roleId, score])
  @@index([roleId, normalizedName])
  @@map("candidate")
}

model CandidateCV {
  id                 String    @id @default(cuid())
  candidateId        String
  originalFileName   String    @db.VarChar(255)
  /// Sanitised, lower-cased file name (without extension) used for duplicate detection.
  normalizedFileName String    @db.VarChar(255)
  fileType           String    @db.VarChar(10)
  /// SHA-256 of the uploaded bytes.
  fileHash           String    @db.Char(64)
  extractedText      String    @db.LongText
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  candidate          Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId, fileHash])
  @@index([candidateId])
  @@index([fileHash])
  @@map("candidate_cv")
}

model SourcingProfile {
  id            String   @id @default(cuid())
  roleId        String
  candidateName String   @db.VarChar(200)
  platform      String   @db.VarChar(20)
  /// Informational only — never fetched or scraped.
  referenceUrl  String?  @db.VarChar(2048)
  profileText   String   @db.LongText
  analysis      Json?
  score         Int?
  verdict       String?  @db.VarChar(20)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  role          Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@index([roleId])
  @@index([roleId, platform])
  @@index([roleId, score])
  @@map("sourcing_profile")
}

/// Recruiter-owned state. Never overwritten by (re)scoring.
model CandidateTracker {
  id             String    @id @default(cuid())
  candidateId    String
  decision       String    @default("Pending") @db.VarChar(30)
  recruiterNotes String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  candidate      Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@unique([candidateId])
  @@map("candidate_tracker")
}

// ─────────────────────────────────────────────────────────────
// Applicants — a shared talent pool, independent of any one role's
// workflow. An applicant may optionally be linked to the role they
// applied for; deleting that role keeps the applicant.
// ─────────────────────────────────────────────────────────────

model Applicant {
  id              String                   @id @default(cuid())
  fullName        String                   @db.VarChar(200)
  /// Lower-cased, whitespace-collapsed name used for search and duplicate hints.
  normalizedName  String                   @db.VarChar(200)
  email           String?                  @db.VarChar(255)
  phone           String?                  @db.VarChar(50)
  location        String?                  @db.VarChar(200)
  currentTitle    String?                  @db.VarChar(200)
  currentCompany  String?                  @db.VarChar(200)
  experienceYears Decimal?                 @db.Decimal(4, 1)
  noticePeriod    String?                  @db.VarChar(100)
  currentCtc      String?                  @db.VarChar(100)
  expectedCtc     String?                  @db.VarChar(100)
  source          String?                  @db.VarChar(100)
  status          String                   @default("New") @db.VarChar(30)
  linkedinUrl     String?                  @db.VarChar(2048)
  portfolioUrl    String?                  @db.VarChar(2048)
  /// string[]
  skills          Json?
  /// Free-form recruiter metadata: { key: string, value: string }[]
  metadata        Json?
  notes           String?                  @db.Text
  roleId          String?
  createdById     String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  role            Role?                    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  createdBy       User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  files           ApplicantFile[]
  applications    RecruitmentApplication[]
  profiles        RecruitmentProfile[]

  @@index([normalizedName])
  @@index([email])
  @@index([status])
  @@index([roleId])
  @@index([updatedAt])
  @@map("applicant")
}

/// Documents attached to an applicant (CV, cover letter, certificates…), stored in the database.
model ApplicantFile {
  id               String                   @id @default(cuid())
  applicantId      String
  /// CV | Cover letter | Certificate | Portfolio | ID proof | Other
  kind             String                   @db.VarChar(30)
  originalFileName String                   @db.VarChar(255)
  mimeType         String                   @db.VarChar(100)
  sizeBytes        Int
  /// SHA-256 of the uploaded bytes.
  fileHash         String                   @db.Char(64)
  data             Bytes                    @db.LongBlob
  /// Plain text pulled from PDF/TXT uploads (null for other formats).
  extractedText    String?                  @db.LongText
  createdAt        DateTime                 @default(now())
  applicant        Applicant                @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applications     RecruitmentApplication[]

  @@unique([applicantId, fileHash])
  @@index([applicantId])
  @@map("applicant_file")
}

// ─────────────────────────────────────────────────────────────
// Recruitment — one hiring drive for a role. Its number (REC-001…)
// is the auto-increment id and is used as the URL slug.
// ─────────────────────────────────────────────────────────────

model Recruitment {
  id            Int                      @id @default(autoincrement())
  roleId        String
  summary       String                   @db.Text
  /// Positions to fill in this drive (defaults to the role's openings).
  openings      Int                      @default(1)
  /// Open | In progress | On hold | Completed | Cancelled
  status        String                   @default("Open") @db.VarChar(20)
  /// Kick-off meeting notes by topic: { responsibilities, skills, experience, team } (markdown strings).
  kickoffFields Json?
  /// The full kick-off meeting notes as pasted (AI can sort these into kickoffFields).
  kickoffRaw    String?                  @db.LongText
  createdById   String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  // Restrict: a role can't be deleted while recruitments still use it.
  role          Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  createdBy     User?                    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  sections      RecruitmentSection[]
  applications  RecruitmentApplication[]
  profiles      RecruitmentProfile[]

  @@index([roleId])
  @@index([status])
  @@map("recruitment")
}

/// Latest AI output for one section (kickoff, market-research, sourcing, outreach, screening, final-decision).
model RecruitmentSection {
  id            String      @id @default(cuid())
  recruitmentId Int
  key           String      @db.VarChar(30)
  input         String?     @db.LongText
  /// e.g. { applicationIds: string[] } for candidate-based sections.
  inputData     Json?
  output        String?     @db.LongText
  /// Structured output (Kick-off: JD, scorecard, posts…).
  outputData    Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  recruitment   Recruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)

  @@unique([recruitmentId, key])
  @@map("recruitment_section")
}

/// An applicant's CV scored against this recruitment's JD. Decision is never overwritten by rescoring.
model RecruitmentApplication {
  id            String         @id @default(cuid())
  recruitmentId Int
  applicantId   String
  cvFileId      String?
  score         Int?
  category      String?        @db.VarChar(20)
  summary       String?        @db.Text
  strengths     Json?
  gaps          Json?
  scoredAt      DateTime?
  /// Pending | Proceed to interview | Hold | Reject
  decision      String         @default("Pending") @db.VarChar(30)
  /// Recruiter's interview screening notes — Recruiter screening writes its report from these.
  screeningNotes String?       @db.LongText
  /// AI screening report written from the notes: ScreeningOutput + generatedAt.
  screeningReport Json?
  /// Personalised outreach for this applicant: OutreachOutput + generatedAt.
  outreachMessages Json?
  /// Candidate-facing rejection message: FinalDecisionOutput + generatedAt.
  finalDecisionMessages Json?
  /// Selected | On hold | Rejected — null until decided.
  finalDecision  String?       @db.VarChar(20)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  recruitment   Recruitment    @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  applicant     Applicant      @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  cvFile        ApplicantFile? @relation(fields: [cvFileId], references: [id], onDelete: SetNull)

  @@unique([recruitmentId, applicantId])
  @@index([recruitmentId, score])
  @@index([applicantId])
  @@map("recruitment_application")
}

/// A LinkedIn / Naukri profile pasted into a recruitment and analysed against its JD.
model RecruitmentProfile {
  id             String      @id @default(cuid())
  recruitmentId  Int
  candidateName  String      @db.VarChar(200)
  /// Lower-cased, whitespace-collapsed name — links a profile to a CV applicant for outreach.
  normalizedName String      @db.VarChar(200)
  platform       String      @db.VarChar(20)
  /// Informational only — never fetched or scraped.
  referenceUrl   String?     @db.VarChar(2048)
  profileText    String      @db.LongText
  analysis       Json?
  score          Int?
  verdict        String?     @db.VarChar(20)
  /// Set once the profile has been added to the recruitment's applicants.
  applicantId    String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  recruitment    Recruitment @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  applicant      Applicant?  @relation(fields: [applicantId], references: [id], onDelete: SetNull)

  @@index([recruitmentId, score])
  @@index([recruitmentId, normalizedName])
  @@map("recruitment_profile")
}
