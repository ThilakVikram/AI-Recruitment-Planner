# MySQL connection used by Prisma (app data + Better Auth tables)
DATABASE_URL="mysql://user:password@localhost:3306/recruiter_ai"
# Only needed for `prisma migrate dev` when the DB user cannot create databases.
# Never required in production (`prisma migrate deploy` does not use it).
SHADOW_DATABASE_URL=""

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Public base URL of the app (used by Better Auth for cookies/redirects/origin checks)
BETTER_AUTH_URL="http://localhost:3000"

# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=""
# e.g. claude-opus-5-5 (or claude-sonnet-5-5 for lower cost)
ANTHROPIC_MODEL=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
